# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chat_db?retryWrites=true&w=majority

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Credentials (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Cross-Domain & Keep-Alive Cron Configuration (Vercel + Render)
FRONTEND_URL=https://your-frontend-app.vercel.app
BACKEND_URL=https://your-backend-api.onrender.com

# Frontend Vite Environment Variable (Set in Vercel Dashboard)
VITE_BACKEND_URL=https://your-backend-api.onrender.com